# ---- Server ----
PORT=3001
# Where the browser app is served from (CORS). Use your real domain in production.
CLIENT_ORIGIN=http://localhost:5173

# ---- Supabase (optional for local dev; without it rooms live in server memory) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Client (only if the API lives on a different origin than the web app) ----
